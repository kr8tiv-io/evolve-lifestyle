# Correct MIME types for static assets on Hostinger (Apache/LiteSpeed)
AddType video/webm .webm
AddType video/mp4 .mp4
AddType font/otf .otf
AddType font/woff2 .woff2
AddType image/webp .webp
AddType image/svg+xml .svg

# Long cache for immutable static assets
<IfModule mod_headers.c>
  <FilesMatch "\.(webm|mp4|otf|woff2|jpg|jpeg|png|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Security headers (SEO + best practice)
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Gzip/Brotli compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>
